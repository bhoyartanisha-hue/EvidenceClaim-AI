{
  "name": "claimiq-root",
  "private": true,
  "scripts": {
    "setup:frontend": "npm --prefix frontend install",
    "setup:backend": "node scripts/setup-backend.mjs",
    "setup": "npm run setup:frontend && npm run setup:backend",
    "dev": "concurrently -k -c \"blue.bold,cyan.bold\" -n \"api,web\" \"node scripts/run-backend.mjs\" \"npm --prefix frontend run dev\"",
    "test:backend": "node scripts/run-backend-test.mjs",
    "test:contract": "node scripts/check-contract.mjs",
    "test": "npm run test:backend && npm run test:contract"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
